[21/02/23 22:24:28:544 UTC]  INFO db.DotConnect: Executing INSERT INTO fileassets_ir (file_name, local_working_inode, local_live_inode, remote_working_inode, remote_live_inode, local_identifier, remote_identifier, endpoint_id, language_id) select DISTINCT li.full_path_lc  as file_name, lcvi.working_inode as local_working_inode, lcvi.live_inode as local_live_inode, t.working_inode as remote_working_inode, t.live_inode as remote_live_inode, lc.identifier as local_identifier, t.identifier as remote_identifier, 'endpointID_1677018268507', t.language_id as language_id FROM identifier li INNER JOIN contentlet lc ON (lc.identifier = li.id and li.asset_type = 'contentlet') INNER JOIN contentlet_version_info lcvi ON (lc.identifier = lcvi.identifier and lc.language_id = lcvi.lang) INNER JOIN structure ls ON (lc.structure_inode = ls.inode and ls.structuretype = 4) INNER JOIN fileassets_temp_endpointID_1677018268507 t ON (li.full_path_lc = t.full_path_lc AND li.host_inode = host_identifier AND lc.identifier <> t.identifier AND lc.language_id = t.language_id )
