[23/11/22 07:20:46:719 UTC]  INFO junit.RuleWatcher: >>> testUpgradeTaskWhenProcedureExistsShouldPass(com.dotmarketing.startup.runonce.Task05225RemoveLoadRecordsToIndexTest) - starting...
[23/11/22 07:20:46:719 UTC]  INFO junit.RuleWatcher: >>>>>>>>>>>>>>>>>>>>>>>>>>
[23/11/22 07:20:46:719 UTC]  INFO db.DotConnect: Executing CREATE PROCEDURE load_records_to_index(@server_id NVARCHAR(100), @records_to_fetch INT, @priority_level INT)
AS
BEGIN
WITH cte AS (
  SELECT TOP(@records_to_fetch) *
  FROM dist_reindex_journal WITH (ROWLOCK, READPAST, UPDLOCK)
  WHERE serverid IS NULL
  AND priority <= @priority_level
  ORDER BY priority ASC)
UPDATE cte
  SET serverid=@server_id
OUTPUT
  INSERTED.*
END;
