WHERE inode.inode=contentlet.inode GROUP BY identifier) custom_select  
WHERE temp.identifier=custom_select.identifier
AND inode.inode=temp.inode AND inode.idate=custom_select.idate 
AND temp.structure_inode = struc.inode) my_query
 WHERE  id=myID
